# Signal account registered or linked in signal-api
# Replace this with the bot account's real Signal number in international format.
BOT_PHONE_NUMBER=+
# Recommended: Set the bot's Signal UUID (obtained via `curl http://127.0.0.1:18080/v1/accounts`).
# Required for native @mentions in groups and when phone number sharing is hidden.
BOT_UUID=

SIGNAL_MEDIA_IMAGE=michifumi/signal-media-bot:latest

# The compose file overrides this to the service hostname in-container.
SIGNAL_API_URL=http://signal-api:8080
WEBHOOK_PATH=/webhook/signal
SIGNAL_API_PORT=18080
BOT_PORT=18000

# Comma-separated names accepted as a group mention, without the @ sign.
BOT_MENTION_NAMES=bot,signalbot
TRIGGER_PREFIXES=/dl,!dl
MAX_FILE_SIZE_MB=100
MAX_URLS_PER_MESSAGE=4
DOWNLOAD_TIMEOUT_SECONDS=300
FXTWITTER_API_URL=https://api.fxtwitter.com
SHARED_MEDIA_DIR=/tmp/signal_shared_media
USER_AGENT=signal-media-bot/1.0
